{
  "name": "home-finder-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "seed:admin": "ts-node src/scripts/seedAdmin.ts",
    "seed:portal-admins": "ts-node src/scripts/seedPortalAdmins.ts",
    "seed:rbac-test": "ts-node src/scripts/seedRbacTestUsers.ts",
    "seed:insurance-settlement": "ts-node src/scripts/seedInsuranceSettlementDemo.ts",
    "wipe:keep-users": "ts-node src/scripts/wipeAllDataExceptUsers.ts",
    "reset:admin": "ts-node src/scripts/resetAdminPassword.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write 'src/**/*.ts'",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "keywords": [
    "home",
    "finder",
    "real-estate",
    "express",
    "typescript",
    "prisma"
  ],
  "author": "Nyasha Karata",
  "license": "ISC",
  "description": "Backend API for a home finder application",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.837.0",
    "@aws-sdk/s3-request-presigner": "^3.837.0",
    "@prisma/client": "^6.7.0",
    "axios": "^1.10.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.16.0",
    "mongoose": "^8.15.1",
    "multer": "^2.0.1",
    "nodemailer": "^6.10.1",
    "nodemon": "^3.1.10",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "paynow": "^2.2.2",
    "pdf-lib": "^1.17.1",
    "socket.io": "^4.8.1",
    "zeptomail": "^6.2.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.0",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/helmet": "^4.0.0",
    "@types/mongodb": "^4.0.7",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.15.17",
    "@types/nodemailer": "^6.4.21",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "prettier": "^3.5.3",
    "prisma": "^6.7.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
}
