{
  "version": 2,
  "builds": [
    { "src": "src/app.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "src/app.ts" }
  ],
  "crons": [
    {
      "path": "/api/cron/rental-reminders",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/distribution",
      "schedule": "0 0 * * *"
    }
  ]
} 